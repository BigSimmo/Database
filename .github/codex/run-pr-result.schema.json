{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "checks", "thread_dispositions", "rerun_failed_run_ids"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "checks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "thread_dispositions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["thread_id", "action", "reply"],
        "properties": {
          "thread_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "action": {
            "type": "string",
            "enum": ["resolve_fixed", "resolve_no_change", "leave_open"]
          },
          "reply": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "rerun_failed_run_ids": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
