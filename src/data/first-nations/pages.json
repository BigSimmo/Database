    {
      "id": "talking",
      "title": "Talking",
      "sections": [
        {
          "id": "talking-asking",
          "tab": "Asking",
          "modules": [
            {
              "id": "talking-deck",
              "title": "Words to try",
              "icon": "message",
              "layout": "deck",
              "blocks": [
                {
                  "kind": "tip",
                  "id": "talking-who-with",
                  "do": "Ask who they would like with them",
                  "why": "The Act names family and community members, including elders.",
                  "say": "Is there someone you would like with you while we talk?",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                },
                {
                  "kind": "tip",
                  "id": "talking-offer-worker",
                  "do": "Offer an Aboriginal mental health worker",
                  "why": "The Act asks for collaboration with Aboriginal mental health workers where practicable.",
                  "say": "Would you like an Aboriginal mental health worker to join us?",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                },
                {
                  "kind": "tip",
                  "id": "talking-plain-words",
                  "do": "Use words that make sense to them",
                  "why": "The Act says communication must be in terms the person is likely to understand.",
                  "say": "Tell me if I use a word that does not make sense.",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                }
              ]
            }
          ]
        },
        {
          "id": "talking-language",
          "tab": "Language",
          "modules": [
            {
              "id": "talking-language-tips",
              "title": "Language",
              "icon": "message",
              "layout": "list",
              "blocks": [
                {
                  "kind": "tip",
                  "id": "talking-interpreter",
                  "do": "Use an interpreter if one is needed",
                  "why": "The Act asks for an interpreter where necessary and practicable.",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                }
              ]
            }
          ]
        },
        {
          "id": "talking-be-aware",
          "tab": "Be aware",
          "modules": [
            {
              "id": "talking-background",
              "title": "Background",
              "icon": "book",
              "layout": "list",
              "blocks": [
                {
                  "kind": "note",
                  "id": "talking-cultural-safety",
                  "heading": "Cultural safety",
                  "text": "Cultural safety is decided by Aboriginal and Torres Strait Islander people, families and communities, not by the clinician.",
                  "sourceId": "ahpra-cultural-safety",
                  "checkedAt": "2026-09-26"
                },
                {
                  "kind": "note",
                  "id": "talking-wellbeing",
                  "heading": "Wellbeing is whole",
                  "text": "Social and emotional wellbeing covers body, mind, family, community, culture, Country and spirit.",
                  "sourceId": "sewb-national-framework",
                  "checkedAt": "2026-09-26"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "family",
      "title": "Family",
      "sections": [
        {
          "id": "family-kinship",
          "tab": "Kinship",
          "modules": [
