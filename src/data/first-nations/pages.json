  "situations": [
    {
      "id": "new-admission",
      "label": "New admission",
      "icon": "bed",
      "phrases": [
        {
          "say": "Would you like an Aboriginal mental health worker to be with us?",
          "why": "The Act asks for collaboration with Aboriginal mental health workers where practicable.",
          "sourceId": "mha-2014-communication-and-cultural-provisions",
          "checkedAt": "2026-09-25"
        },
        {
          "say": "Is there someone you would like with you while we talk?",
          "why": "The Act names family and community members, including elders.",
          "sourceId": "mha-2014-communication-and-cultural-provisions",
          "checkedAt": "2026-09-25"
        },
        {
          "say": "Which language would you like to talk in?",
          "why": "The Act says communication must be in a language the person is likely to understand.",
          "sourceId": "mha-2014-communication-and-cultural-provisions",
          "checkedAt": "2026-09-25"
        }
      ],
      "firstStepRef": "bedside-offer-worker",
      "plan": ["bedside-offer-worker", "bedside-who-with", "bedside-language", "bedside-home", "bedside-sorry-business"]
    },
    {
      "id": "wants-to-leave",
      "label": "Wants to leave",
      "icon": "door",
      "phrases": [
        {
          "say": "Can I ask an Aboriginal mental health worker to come and talk with us?",
          "why": "The Act asks for collaboration with Aboriginal mental health workers where practicable.",
          "sourceId": "mha-2014-communication-and-cultural-provisions",
          "checkedAt": "2026-09-25"
        },
        {
          "say": "Is there someone in your family you would like us to call?",
          "why": "The Act asks services to have regard to the views of the family.",
          "sourceId": "mha-2014-communication-and-cultural-provisions",
          "checkedAt": "2026-09-25"
        },
        {
          "say": "Would it help to talk in your own language, with an interpreter?",
          "why": "Aboriginal Interpreting WA is the primary language service for Aboriginal people in WA.",
          "sourceId": "wa-health-language-services-guidelines-2025",
          "checkedAt": "2026-09-25"
        }
      ],
      "firstStepRef": "bedside-offer-worker",
      "plan": ["bedside-offer-worker", "family-who-involve", "contacts-aiwa", "gh-13yarn"],
      "riskLineRef": "wants-to-leave-risk"
    },
    {
      "id": "family-meeting",
      "label": "Family meeting",
      "icon": "users",
      "phrases": [
        {
          "say": "Who in your family should be part of this talk?",
          "why": "Cultural safety is decided by the person, their family and community.",
          "sourceId": "ahpra-cultural-safety",
          "checkedAt": "2026-09-26"
        },
        {
          "say": "Would you like an elder or someone from community here too?",
          "why": "The Act names elders among the community members to work with.",
          "sourceId": "mha-2014-communication-and-cultural-provisions",
          "checkedAt": "2026-09-25"
        },
        {
          "say": "Shall we book an interpreter to be here in person?",
          "why": "WA Health guidelines say phone interpreting is not suited to sensitive mental health talks.",
          "sourceId": "wa-health-language-services-guidelines-2025",
          "checkedAt": "2026-09-25"
        }
      ],
      "firstStepRef": "family-who-involve",
      "plan": ["family-who-involve", "family-elder", "contacts-interpreter-in-person"]
    },
    {
      "id": "mental-health-act",
      "label": "Mental Health Act",
      "icon": "scale",
      "phrases": [
        {
          "say": "I want to explain what the Mental Health Act means for you, in words that make sense to you.",
          "why": "The Act says communication must be in terms the person is likely to understand.",
          "sourceId": "mha-2014-communication-and-cultural-provisions",
          "checkedAt": "2026-09-25"
        },
        {
          "say": "Would you like an Aboriginal mental health worker with us for this examination?",
          "why": "Section 81 asks for the examination to be in collaboration with Aboriginal mental health workers where practicable.",
          "sourceId": "mha-2014-communication-and-cultural-provisions",
          "checkedAt": "2026-09-25"
        },
        {
          "say": "Is there an elder or traditional healer you would like us to involve?",
          "why": "Section 81 names elders and traditional healers.",
          "sourceId": "mha-2014-communication-and-cultural-provisions",
          "checkedAt": "2026-09-25"
        }
      ],
      "firstStepRef": "bedside-offer-worker",
      "plan": ["bedside-offer-worker", "ward-healer", "talking-plain-words", "mh-culture-not-illness"]
    },
    {
      "id": "sorry-business",
      "label": "Sorry Business",
      "icon": "feather",
      "phrases": [
        {
          "say": "Is anything happening in your family or community right now that we should know about?",
          "why": "Family and community are part of social and emotional wellbeing.",
          "sourceId": "sewb-national-framework",
          "checkedAt": "2026-09-26"
        },
        {
          "say": "What do you need from us so you can take part in family and cultural business?",
