              "title": "Words to try",
              "icon": "users",
              "layout": "deck",
              "blocks": [
                {
                  "kind": "tip",
                  "id": "family-who-involve",
                  "do": "Ask who in the family should be involved",
                  "why": "The Act asks services to have regard to the views of the family.",
                  "say": "Who in your family should we talk with?",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                },
                {
                  "kind": "tip",
                  "id": "family-elder",
                  "do": "Ask about elders",
                  "why": "The Act names elders among the community members to work with.",
                  "say": "Is there an elder you would like us to involve?",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                }
              ]
            },
            {
              "id": "family-who-to-involve",
              "title": "Who to involve",
              "icon": "users",
              "layout": "list",
              "blocks": [
                {
                  "kind": "tip",
                  "id": "family-who-counts",
                  "do": "Let the person and family say who counts as family",
                  "why": "Cultural safety is decided by the person, their family and community.",
                  "sourceId": "ahpra-cultural-safety",
                  "checkedAt": "2026-09-26"
                }
              ]
            }
          ]
        },
        {
          "id": "family-visitors",
          "tab": "Visitors",
          "modules": [
            {
              "id": "family-visiting",
              "title": "Visitors",
              "icon": "door",
              "layout": "list",
              "blocks": [
                {
                  "kind": "tip",
                  "id": "family-visiting-ask",
                  "do": "Ask the person and family what visiting would help",
                  "why": "Care should fit cultural practice and the views of the family.",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "mental-health",
      "title": "Mental health",
      "sections": [
        {
          "id": "mh-act",
          "tab": "Act",
          "modules": [
            {
              "id": "mh-s81",
              "title": "Section 81",
              "icon": "scale",
              "layout": "quote",
              "blocks": [
                {
                  "kind": "quote",
                  "id": "mh-s81-quote",
                  "heading": "Mental Health Act 2014 (WA), section 81",
                  "text": "To the extent that it is practicable and appropriate to do so, the examination of a person who is of Aboriginal or Torres Strait Islander descent must be conducted in collaboration with — (a) Aboriginal or Torres Strait Islander mental health workers; and (b) significant members of the person's community, including elders and traditional healers.",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                }
              ]
            },
            {
              "id": "mh-before-you-assess",
              "title": "Before you assess",
              "icon": "clipboard",
              "layout": "steps",
              "blocks": [
                {
                  "kind": "steps",
                  "id": "mh-before-steps",
                  "heading": "Before you assess",
                  "items": [
                    {
                      "title": "Offer an Aboriginal mental health worker",
                      "detail": "Involve them where practicable and appropriate."
                    },
                    {
                      "title": "Ask about family, elders or healers",
                      "detail": "Ask the person who they want involved."
                    },
                    {
                      "title": "Check language",
                      "detail": "Use an interpreter if needed and practicable."
                    }
                  ],
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                }
              ]
            }
          ]
        },
        {
          "id": "mh-assessment",
          "tab": "Assessment",
          "modules": [
            {
              "id": "mh-assessment-notes",
              "title": "Assessment",
              "icon": "brain",
              "layout": "list",
              "blocks": [
                {
                  "kind": "note",
                  "id": "mh-culture-not-illness",
                  "heading": "Culture is not illness",
                  "text": "Under the Act, holding a cultural belief or taking part in cultural activity does not by itself mean a person has a mental illness.",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                },
                {
                  "kind": "note",
                  "id": "mh-information-from-others",
                  "heading": "Information from others",
                  "text": "Information from an Aboriginal mental health worker or community member can inform the examination, but the Act says an order cannot rest on that information alone.",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                },
                {
                  "kind": "noteWording",
                  "id": "mh-what-to-record",
                  "heading": "What to record",
                  "template": "Examined in collaboration with [blank] (Aboriginal mental health worker) and [blank] (family or community member), in line with s 81.",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                }
              ]
            }
          ]
        },
        {
          "id": "mh-wellbeing",
          "tab": "Wellbeing",
          "modules": [
            {
              "id": "mh-sewb",
              "title": "Social and emotional wellbeing",
              "icon": "feather",
              "layout": "list",
              "blocks": [
                {
                  "kind": "linkList",
                  "id": "mh-sewb-links",
                  "heading": "Read more",
                  "items": [
                    {
                      "label": "National SEWB framework",
                      "detail": "Aboriginal and Torres Strait Islander mental health and social and emotional wellbeing",
                      "href": "https://www.niaa.gov.au/sites/default/files/documents/publications/mhsewb-framework_0.pdf"
                    }
                  ],
                  "sourceId": "sewb-national-framework",
                  "checkedAt": "2026-09-26"
                }
              ]
            }
          ]
        }
      ]
    },
