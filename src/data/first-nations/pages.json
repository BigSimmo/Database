    {
      "id": "bedside",
      "title": "Bedside",
      "sections": [
        {
          "id": "bedside",
          "tab": "Bedside",
          "modules": [
            {
              "id": "before-you-go-in",
              "title": "Before you go in",
              "icon": "check",
              "layout": "list",
              "blocks": [
                {
                  "kind": "tip",
                  "id": "bedside-offer-worker",
                  "do": "Offer an Aboriginal mental health worker or liaison officer",
                  "why": "The Act asks for assessment and examination with Aboriginal mental health workers, where practicable and appropriate.",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                },
                {
                  "kind": "tip",
                  "id": "bedside-who-with",
                  "do": "Ask who they would like with them",
                  "why": "The Act names family and significant community members, including elders and traditional healers.",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                },
                {
                  "kind": "tip",
                  "id": "bedside-language",
                  "do": "Ask which language they are most comfortable in",
                  "why": "Aboriginal Interpreting WA is the primary language service for Aboriginal people in WA.",
                  "sourceId": "wa-health-language-services-guidelines-2025",
                  "checkedAt": "2026-09-25"
                },
                {
                  "kind": "tip",
                  "id": "bedside-home",
                  "do": "Ask where home is",
                  "why": "Connection to Country, family and community is part of social and emotional wellbeing.",
                  "sourceId": "sewb-national-framework",
                  "checkedAt": "2026-09-26"
                },
                {
                  "kind": "tip",
                  "id": "bedside-sorry-business",
                  "do": "Check whether family or cultural business, such as Sorry Business, is happening",
                  "why": "Care should fit the person's cultural and spiritual practices and the views of their family.",
                  "sourceId": "mha-2014-communication-and-cultural-provisions",
                  "checkedAt": "2026-09-25"
                }
              ]
            }
          ]
        }
      ]
    },
