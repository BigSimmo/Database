{
  "version": 1,
  "id": "delivery",
  "kind": "area",
  "name": "Delivery and assurance",
  "owns": "Getting a change safely from branch to live: CI, git hooks, gates, budgets, containers, deploy config and test tooling.",
  "canonicalDocs": ["docs/agents/verification-gates.md", "docs/testing.md", "docs/deployment-architecture.md"],
  "paths": [
    ".dockerignore",
    ".editorconfig",
    ".gitattributes",
    ".githooks/**",
    ".github/**",
    ".gitignore",
    ".gitleaksignore",
    ".node-version",
    ".npmrc",
    ".nvmrc",
    ".prettierignore",
    ".prettierrc",
    ".vscode/**",
    "Dockerfile",
    "Dockerfile.worker",
    "bundle-budget.json",
    "deno.lock",
    "diff-integrity.json",
    "docs/deployment/**",
    "eslint.config.mjs",
    "knip.json",
    "lighthouse-budget.json",
    "next-env.typecheck.d.ts",
    "package-lock.json",
    "package.json",
    "playwright.config.ts",
    "playwright.visual.config.ts",
    "railway.app.json",
    "railway.worker.json",
    "scripts/archive/**",
    "scripts/check-organisation.mjs",
    "scripts/deploy/**",
    "tests/check-organisation.test.ts",
    "tests/helpers/**",
    "tests/setup/**",
    "tests/stubs/**",
    "tsconfig.json",
    "tsconfig.typecheck.json",
    "vitest.config.mts",
    "vitest.coverage-shard.config.mts"
