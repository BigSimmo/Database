{
  "schemaVersion": 2,
  "requiredProofCategories": ["source", "exports", "productImports", "designSync", "preview", "tests", "baseline"],
  "productionSurfaces": [
    {
      "id": "root-shell-and-settings",
      "disposition": "shared-shell",
      "routes": ["src/app/(search-app)/page.tsx"],
      "routeRoots": true,
      "roots": [
        "src/app/layout.tsx",
        "src/components/ClinicalDashboard.tsx",
        "src/components/clinical-dashboard/settings-dialog.tsx"
      ],
      "permittedComponentFamilies": ["controls", "feedback", "layout", "source", "answer"],
      "expectedShellState": "compatibility",
      "sanctionedSpecialPatterns": ["OverlayRoot", "ClinicalDashboard", "SettingsDialog"],
      "documentedDisposition": "The root route, shared application shell, global overlays, answer orchestration and settings UI are owned by the mounted shell rather than separate settings routes."
    },
    {
      "id": "catalogues-forms-and-info",
      "disposition": "owned",
      "routes": [
        "src/app/(search-app)/dsm/compare/page.tsx",
