  /*
   * THE SHEET IS ONE PAGE WHERE IT CAN BE, and the numbers below are measured, not reasoned.
   *
   * Success criterion 6 asks for one A4 sheet. Under print media at A4 width the heading block plus
   * the sheet measured 1059px on the 17-bed `bty-adult-secure` against 1123px of page, and 1170px
   * on the 20-bed `rph-adult-secure` — 47px, about three lines, over.
   *
   * **The obvious fix was tried and made it worse, which is why the column minimum is NOT touched
   * here.** Narrowing it to get all five groups into one row instead of three-then-two looked
   * right and measured wrong: narrower columns wrap the prose harder, and every group grows more
   * than the saved row was worth. Swept across 10 / 13 / 16 / 20 / 24rem on three wards, the
   * screen's own 13rem is the minimum at every one of them (bty 1051 / 1162 / 1365 against
   * 1231 / 1447 / 1626 at 10rem and 1178 / 1358 / 1573 at 16rem). The sweep is recorded so nobody
   * re-derives the plausible version of this and ships it.
   *
   * What is left is whitespace: tighter gutters between groups and tighter standing-note rules.
   * **Nothing is removed to gain the space** — not a row, not a note, not a person. That matters:
   * the occupant list carries a standing rule that it is never truncated, because a reader cannot
   * tell a shortened list is short, and the same rule governs here.
   *
   * A ward with many people in the attention groups still runs to a second page, and that is
   * correct rather than a defect: the alternative is a sheet that quietly leaves somebody off.
   */
  .sheetGroups {
    gap: var(--wb-space-8);
    margin-top: var(--wb-space-8);
  }

  .sheetNote {
    margin-top: var(--wb-space-4);
    padding-top: var(--wb-space-4);
  }

  /* The rows already divide on a hairline, so the screen's extra gap around it is doing the job
     twice. Halved rather than removed: a rule with no air either side reads as a table border. */
  .sheetList {
    gap: var(--wb-space-4);
  }

  .sheetRow:not(:first-child) {
    padding-top: var(--wb-space-4);
  }

  .sheet {
    break-after: page;
    background: Canvas;
    border-color: CanvasText;
    /* On the container as well as on every class inside it, so a line of text added later without a
       class of its own inherits the page's ink rather than the dark theme's. */
    color: CanvasText;
  }

  .sheetHeading,
  .sheetIntro,
  .sheetSince,
  .sheetGroupHeading,
  .sheetGroupCount,
  .sheetRowLead,
  .sheetRowBand,
  .sheetRowLine,
  /* Added 2026-08-30 WITH the element itself, not after somebody noticed a blank line on paper.
     `.sheetRowAway` sets its own `--text-heading`, which resolves to a near-white in the dark
     theme — so without this the one line saying a patient is not on the ward printed white on
     white, on the sheet that is read aloud at handover. Exactly the defect this block already
     exists to fix, reintroduced by a new rule that set a colour. */
  .sheetRowAway,
  .sheetNote {
    color: CanvasText;
  }

  .sheetGroup {
    border-left-color: CanvasText;
  }

  .sheetRow:not(:first-child),
  .sheetNote {
    border-top-color: CanvasText;
  }

  .flowColumn,
  .destinations {
    display: none !important;
  }

  /* A group split across a page break loses either its heading or its rows, and a reader has no way
     to tell which half they are holding. Kept whole, the same way `.bed` and `.person` already are. */
  .sheetGroup,
  .sheetRow {
    break-inside: avoid;
  }

  /*
   * The rest of the board's buttons are genuinely chrome and stay hidden: the triage toggle and
   * the slide-out's Close cannot be operated on paper, and the basis they select is printed in
   * words on the \"Going out today\" panel instead, so nothing is lost by their absence.
   *
   * The slide-out itself goes too. It is one person chosen by an interaction that leaves no mark
   * on the sheet, and the full list below carries that person along with everyone else — with the
   * selected entry marked in words and weight, so a reader can still see which one was open.
   *
   * `.triageToggle` goes as a WHOLE GROUP, not just its buttons — found by printing the page and
   * looking at it. The global reset removes the two buttons but not the `<span>` labelling them,
   * so the sheet carried a heading reading \"GOING OUT SHOWS\" with nothing whatever underneath it:
   * a label for a control the reader cannot see, which reads as content that failed to render. The
   * basis it selects is printed in words on the \"Going out today\" panel instead, so nothing is
   * lost by removing the group entirely.
   */
  .detail,
  .selectHint,
  .triageToggle {
    display: none !important;
  }

  /*
   * WHO IS IN THESE BEDS, restored: every occupant and their discharge plan. This is the deliverable
   * from 281bdf83f, kept whole on paper after the screen moved to one-at-a-time selection.
   */
  /*
   * Same measurement, same fix, one panel over. This aside carries the identical dark
   * `--surface-chrome` fill and near-white ink, and it is pages three and four of the same printed
   * document — so a sheet whose page one had been repaired while its occupant list still printed
   * white on white would be a half-fixed defect, which is worse than an obvious one.
   */
  .people {
    display: block;
    break-before: page;
    background: Canvas;
    border-color: CanvasText;
    color: CanvasText;
  }

  /* The hairline between occupants is `--border`, which is pale by design in the dark theme and so
     disappears on white stock along with the ink it separates. Drawn in the page's own ink instead,
     the same treatment the sheet's own rules take a few lines up. */
  .person:not(:first-child) {
    border-top-color: CanvasText;
  }

  .peopleHeading,
  .peopleIntro,
  .personStay,
  .personDays,
  .personBand,
  .personNoStay,
  .personWho,
  .personLine,
  /* The fourth of the same defect, all introduced in one night by rules that each set a colour.
     `.personAway` is the people panel's copy of the at-an-ED line; the sheet's copy is handled
     with the sheet block above. Neither is optional on paper: a printed occupant list that cannot
     say somebody is off the ward is the list a handover reads from. */
  .personAway,
  .personExpected,
  .personBlocker,
  .personSelectedMark {
    color: CanvasText;
  }

  /* Selection on paper is WEIGHT and a word, never a fill — a filled entry on a sheet that has
     recorded no decision reads as a decision made. */
  .personSelected {
    border-left: var(--wb-outline-heavy) solid CanvasText;
    padding-left: var(--wb-space-8);
  }

  .personSelectedMark {
    margin: 0 0 var(--wb-space-4);
    font-size: var(--text-3xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
}

/*
 * Reserve the fixed phone bar's height, the same way every other Ward Flow shell does
 * (`ward-management.module.css`, `ward-management-modes.module.css`, and the rest).
 *
 * Added at the ward board fold, 2026-08-29. This file and the phone contract that requires it were
 * built on different branches and had never met: the board screen shipped with no phone media query
 * at all, so on a phone its first row would have sat underneath the fixed bar. Nothing on the board
 * branch could have caught it, because the contract lived on the other one — which is the fold
 * doing its job rather than the fold breaking something.
 */
@media (max-width: 40rem) {
  .screen {
    /* Reserve the fixed phone bar (ward-sidebar.module.css). */
    padding-top: var(--spacing-ward-phone-bar);
  }
}

/* The printed list's \"Selected on screen\" marker. Defined on the base selector as well as in the
   print block so the class is never defined only inside a media query — the same discipline the
   band ramp holds to. The panel itself is `display: none` on screen, so these are only ever seen
   on paper; they are declared here so nothing about them is conditional. */
.personSelected {
  border-left: var(--wb-outline-heavy) solid var(--text-heading);
  padding-left: var(--wb-space-8);
}

.personSelectedMark {
  margin: 0 0 var(--wb-space-4);
  color: var(--text-heading);
  font-size: var(--text-3xs);
  font-weight: 700;
  letter-spacing: var(--tracking-label);
  text-transform: uppercase;
}
