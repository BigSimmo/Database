+/*
+ * The statistics SECTION screens — overview, comparisons, and the two per-unit detail pages. Same
+ * self-contained-tokens convention every other ward-management module documents on its own root
+ * class (see `statistics.module.css`, `ward-index.module.css`): every local custom property this
+ * file needs is declared here, never borrowed from another module's scope, and every colour is a
+ * design token rather than a literal.
+ *
+ * ⚠️ NOTHING IN THIS FILE CHANGES WITH THE VALUE OF A FIGURE, for the same reason the statistics
+ * home page says so on its own module: no threshold styling, no warning ramp, no green-for-good.
+ * It is easier to hold to here than there, because these screens render no figures at all yet —
+ * which is exactly why the rule is written down now, before the first number arrives.
+ *
+ * ⚠️ THERE IS NO "PLACEHOLDER" OR "SKELETON" TREATMENT — no grey block, no shimmer, no dashed
+ * outline standing where a number will go. A shape that looks like a figure reads as a figure that
+ * has not loaded yet, and this whole screen exists to keep "not built" and "not loaded" apart. An
+ * unbuilt section is a sentence, in ordinary body text, saying so.
+ */
+.screen {
+  --ss-space-4: 0.25rem;
+  --ss-space-6: 0.375rem;
+  --ss-space-8: 0.5rem;
+  --ss-space-10: 0.625rem;
+  --ss-space-12: 0.75rem;
+  --ss-space-14: 0.875rem;
+  --ss-space-16: 1rem;
+  --ss-space-20: 1.25rem;
+  --ss-space-24: 1.5rem;
+  /* The production tap target, 3rem / 48px, via the shared token. Never `min-h-11` — that is the
+     value that reintroduced a known `ui-smoke` flake elsewhere in this repository. */
+  --ss-tap: var(--spacing-tap);
+  --ss-leading-body: 1.45;
+  --ss-column: 18rem;
+
+  display: grid;
+  min-height: 100dvh;
+  grid-template-columns: auto minmax(0, 1fr);
+  background: var(--surface);
+  color: var(--text);
+}
+
+.main {
+  grid-column: 2;
+  display: flex;
+  min-width: 0;
+  flex-direction: column;
+  gap: var(--ss-space-16);
+  overflow-x: hidden;
+  overflow-y: auto;
+  padding: var(--ss-space-16) var(--ss-space-20) var(--ss-space-24);
+}
+
+.governanceBanner {
+  display: flex;
+  min-height: var(--ss-tap);
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--ss-space-12);
+  border-bottom: 0.0625rem solid var(--border);
+  background: var(--surface-chrome);
+  padding: var(--ss-space-8) var(--ss-space-12);
+}
+
+.governanceBanner p {
+  min-width: 0;
+  flex: 1 1 12rem;
+  margin: 0;
+  color: var(--text-muted);
+  font-size: var(--text-3xs);
+  line-height: var(--ss-leading-body);
+}
+
+.prototypeBadge {
+  flex-shrink: 0;
+  border: 0.0625rem solid var(--warning-border);
+  border-radius: var(--radius-sm);
+  background: var(--warning-bg);
+  padding: var(--ss-space-4) var(--ss-space-8);
+  color: var(--warning-text);
+  font-size: var(--text-3xs);
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+
+/* The way back to the hub. Its own row above the heading, and a full tap target, because on a
+   phone this is the only way back out of a section that has nothing else to click. */
+.backLink {
+  display: inline-flex;
+  min-height: var(--ss-tap);
+  align-items: center;
+  align-self: flex-start;
+  color: var(--text-muted);
+  font-size: var(--text-xs);
+  text-decoration: none;
+}
+
+.backLink:hover {
+  color: var(--text-heading);
+  text-decoration: underline;
+}
+
+.backLink:focus-visible {
+  outline: 0.125rem solid var(--focus);
+  outline-offset: 0.125rem;
+}
+
+.pageHeader {
+  display: flex;
+  flex-direction: column;
+  gap: var(--ss-space-4);
+}
+
+/* Which section of the statistics screen this page belongs to. Quiet, above the title, so a reader
+   who arrived on a link rather than through the hub still knows where they are. */
+.eyebrow {
+  margin: 0;
+  color: var(--text-muted);
+  font-size: var(--text-3xs);
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+
+.pageTitle {
+  margin: 0;
+  color: var(--text-heading);
+  font-size: var(--text-lg, 1.125rem);
+  font-weight: 700;
+}
+
+.pageSubtitle {
+  margin: 0;
+  color: var(--text-muted);
+  font-size: var(--text-xs);
+}
+
+/* The access claim and the fact that nothing enforces it. Full width, full text, above everything
+   the page has to say — the same treatment the statistics home page gives it, because a reader who
+   arrives here on a direct link never saw it there. */
+.notice {
+  margin: 0;
+  border: 0.0625rem solid var(--warning-border);
+  border-radius: var(--radius-lg);
+  background: var(--warning-bg);
+  padding: var(--ss-space-10) var(--ss-space-12);
+  color: var(--warning-text);
+  font-size: var(--text-xs);
+  line-height: var(--ss-leading-body);
+}
+
+.section {
+  display: grid;
+  gap: var(--ss-space-12);
+  border: 0.0625rem solid var(--border);
+  border-radius: var(--radius-lg);
+  background: var(--surface-subtle);
+  padding: var(--ss-space-12) var(--ss-space-14);
+}
+
+.sectionHeading {
+  margin: 0;
+  color: var(--text-heading);
+  font-size: var(--text-sm, 0.875rem);
+  font-weight: 700;
+}
+
+.body {
+  margin: 0;
+  color: var(--text);
+  font-size: var(--text-xs);
+  line-height: var(--ss-leading-body);
+}
+
+/*
+ * "This is not built yet, and here is what it will hold." Deliberately NOT the `.absence` warning
+ * treatment the home page uses: an absence there means a figure that CANNOT be measured against
+ * today's model, which is a permanent property of the data. This is a section nobody has written
+ * yet, which is a temporary property of the work. Dressing the second as the first would tell a
+ * reader the figures are impossible when they are merely absent — and would leave no distinct
+ * treatment for the ones that really are impossible.
+ */
+.notBuilt {
+  margin: 0;
+  border-left: 0.125rem solid var(--border-strong);
+  padding-left: var(--ss-space-10);
+  color: var(--text);
+  font-size: var(--text-xs);
+  line-height: var(--ss-leading-body);
+}
+
+.note {
+  margin: 0;
+  color: var(--text-muted);
+  font-size: var(--text-3xs);
+  line-height: var(--ss-leading-body);
+}
+
+/* A field name from the model, quoted so a reader can go and look at the record the sentence is
+   about rather than taking the page's word for it. Matches `statistics.module.css`'s `.field`. */
+.field {
+  border-radius: var(--radius-xs);
+  background: var(--surface-inset);
+  padding: 0 var(--ss-space-4);
+  font-family: var(--font-mono, monospace);
+  font-size: var(--text-3xs);
+}
+
+/*
+ * The unit chooser. `auto-fill`, not `auto-fit`, for the same reason `ward-index.module.css` gives:
+ * `auto-fit` collapses empty tracks and stretches a lone card the full width, so a group with one
+ * unit would render a card three times the size of every other one and read as emphasis nobody
+ * intended.
+ */
+.unitList {
+  display: grid;
+  gap: var(--ss-space-8);
+  margin: 0;
+  padding: 0;
+  grid-template-columns: repeat(auto-fill, minmax(var(--ss-column), 1fr));
+  list-style: none;
+}
+
+.unitItem {
+  display: flex;
+  min-width: 0;
+}
+
+/* The whole card is the link, so the tap target is the card and not a line of text inside it. */
+.unitLink {
+  display: flex;
+  min-width: 0;
+  min-height: var(--ss-tap);
+  flex: 1 1 auto;
+  flex-direction: column;
+  justify-content: center;
+  gap: var(--ss-space-4);
+  border: 0.0625rem solid var(--border);
+  border-radius: var(--radius-md);
+  background: var(--surface-raised);
+  padding: var(--ss-space-10) var(--ss-space-12);
+  color: var(--text);
+  text-decoration: none;
+}
+
+.unitLink:hover {
+  border-color: var(--clinical-accent-border);
+  background: var(--surface-highlight);
+}
+
+.unitLink:focus-visible {
+  outline: 0.125rem solid var(--focus);
+  outline-offset: 0.125rem;
+}
+
+.unitName {
+  color: var(--text-heading);
+  font-size: var(--text-sm, 0.875rem);
+  font-weight: 700;
+  overflow-wrap: anywhere;
+}
+
+.unitKind {
+  color: var(--text-muted);
+  font-size: var(--text-3xs);
+}
+
+.emptyNote {
+  margin: 0;
+  color: var(--text-muted);
+  font-size: var(--text-xs);
+  font-style: italic;
+}
+
+/* An id in the address that resolves to nothing. Warning treatment, because it is the one state on
+   these pages where what the reader asked for does not exist and the page must not appear to have
+   answered them anyway. */
+.notFoundHeading {
+  margin: 0;
+  color: var(--text-heading);
+  font-size: var(--text-lg, 1.125rem);
+  font-weight: 700;
+}
+
+.notFoundBody {
+  margin: 0;
+  border: 0.0625rem solid var(--warning-border);
+  border-radius: var(--radius-lg);
+  background: var(--warning-bg);
+  padding: var(--ss-space-10) var(--ss-space-12);
+  color: var(--warning-text);
+  font-size: var(--text-xs);
+  line-height: var(--ss-leading-body);
+}
+
+.unresolvedId {
+  border-radius: var(--radius-xs);
+  background: var(--surface-inset);
+  padding: 0 var(--ss-space-6);
+  color: var(--text);
+  font-family: var(--font-mono, monospace);
+  font-size: var(--text-3xs);
+  overflow-wrap: anywhere;
+}
+
+/*
+ * The phone reserve, and it is the most consequential rule in this file.
+ *
+ * `ClinicalRail`'s phone bar is `position: fixed; top: 0; height: var(--spacing-ward-phone-bar)`
+ * (`ward-sidebar.module.css`), and each shell reserves that height in its own phone media query.
+ * `statistics.module.css` shipped with no media query at all, so below 40rem the fixed bar covered
+ * the top of the page — which on that page is the sentence "These are not real figures."
+ *
+ * ⚠️ **The one disclaimer that must never be covered was the first thing hidden**, and jsdom, `tsc`
+ * and eslint are all blind to it, so nothing in the suite could have caught it. These four screens
+ * put the same disclaimer in the same place, so they would have inherited the same defect. The
+ * value comes from the shared token rather than being measured afresh here — a second figure for
+ * one fact is how the two drift apart the day the bar changes height.
+ */
+@media (max-width: 40rem) {
+  .screen {
+    padding-top: var(--spacing-ward-phone-bar);
+  }
+}
