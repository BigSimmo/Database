{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker",
    "watchPatterns": [
      "/Dockerfile.worker",
      "/.dockerignore",
      "/.npmrc",
      "/.nvmrc",
      "/package.json",
      "/package-lock.json",
      "/tsconfig.json",
      "/railway.worker.json",
      "/data/**",
      "!/data/repo-awareness-snapshot.json",
      "!/data/outstanding-issues-snapshot.json",
      "/src/lib/**",
      "/src/data/**",
      "/worker/**",
      "/eval/docling/requirements.txt",
      "/scripts/build-worker.mjs",
      "/scripts/check-installed-lock-parity.mjs",
      "/scripts/check-node-engine.cjs",
      "/scripts/enable-server-only-stub.mjs",
      "/scripts/install-git-hooks.mjs",
      "/scripts/register-server-only.mjs",
      "/scripts/resolve-tsx-cli.mjs",
      "/scripts/run-tsx.mjs",
      "/tests/stubs/server-only.ts",
      "/scripts/deploy/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckPort": 3001,
    "healthcheckTimeout": 10,
    "restartPolicyType": "ALWAYS",
    "preDeployCommand": ["node /app/scripts/deploy/await-migrations.mjs"],
    "startCommand": "node dist/worker/index.mjs",
    "env": {
      "WORKER_HEALTH_PORT": "3001"
    },
    "serviceConfig": {
      "port": 3001,
      "cpuRequest": "1000m",
      "cpuLimit": "4000m",
      "memoryRequest": "2Gi",
      "memoryLimit": "4Gi"
    },
    "concurrency": {
      "maxConcurrentRequests": 10,
      "requestTimeoutSeconds": 3600
    },
    "multiRegionConfig": {
      "asia-southeast1-eqsg3a": {
        "numReplicas": 2
      }
    }
  }
}
