{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/Dockerfile",
      "/.dockerignore",
      "/.npmrc",
      "/.nvmrc",
      "/package.json",
      "/package-lock.json",
      "/next.config.ts",
      "/postcss.config.mjs",
      "/tsconfig.json",
      "/railway.app.json",
      "/data/**",
      "!/data/repo-awareness-snapshot.json",
      "!/data/outstanding-issues-snapshot.json",
      "/public/**",
      "/src/**",
      "/scripts/check-client-bundle-secrets.mjs",
      "/scripts/check-installed-lock-parity.mjs",
      "/scripts/check-node-engine.cjs",
      "/scripts/check-upload-limit-parity.mjs",
      "/scripts/guard-next-build.mjs",
      "/scripts/install-git-hooks.mjs",
      "/scripts/run-heavy.mjs",
      "/scripts/deploy/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "preDeployCommand": ["node /app/scripts/deploy/await-migrations.mjs"],
    "startCommand": "node node_modules/next/dist/bin/next start -H 0.0.0.0 -p $PORT",
    "deploymentStrategy": {
      "strategy": "canary",
      "canaryFraction": 0.25,
      "canaryDuration": 300
    },
    "serviceConfig": {
      "port": 3000,
      "cpuRequest": "500m",
      "cpuLimit": "2000m",
      "memoryRequest": "512Mi",
      "memoryLimit": "2Gi"
    },
    "rollingUpdateConfig": {
      "maxSurge": "50%",
      "maxUnavailable": "25%",
      "minHealthyPercent": 75,
      "maxHealthyPercent": 150
    },
    "multiRegionConfig": {
      "asia-southeast1-eqsg3a": {
        "numReplicas": 2
      }
    }
  }
}
